<?xml version="1.0" encoding="utf-8"?>
<pysystest type="auto">

    <description>
        <title>Guesser - deploy contract and guess the value</title>
        <purpose><![CDATA[
A simple smart contract which hard codes a value which it is necessary to guess. Test is setup to run
against Obscuro, Ropsten or Ganache.
]]>
        </purpose>
    </description>

    <classification>
        <groups inherit="true">
            <group></group>
        </groups>
        <modes inherit="true">
            <mode>obscuro</mode>
            <mode>ropsten</mode>
            <mode>ganache</mode>
        </modes>
    </classification>

    <data>
        <class name="PySysTest" module="run"/>
    </data>

    <traceability>
        <requirements>
            <requirement id=""/>
        </requirements>
    </traceability>
</pysystest>
